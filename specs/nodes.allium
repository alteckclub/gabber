-- allium: 2

-- Gabber Node Library Specification
-- Distilled from engine/gabber/nodes/ implementation

-- Scope: All node types for the Gabber graph execution engine
-- Includes: Core nodes, logic nodes, media nodes, primitive nodes, utility nodes,
--           timing nodes, subgraph nodes, tool nodes, debug nodes, STT/TTS/LLM nodes
-- Excludes:
--   - Engine graph execution (see engine.allium)
--   - Editor protocol (see editor.allium)

-- ============================================================================
-- ENUMS AND TYPE DEFINITIONS
-- ============================================================================

enum CompareOperator {
    LT
    LE
    EQ
    NE
    GE
    GT
}

enum MessageRole {
    System
    User
    Assistant
    Tool
}

enum CompareOperatorString {
    EQUALS
    NOT_EQUALS
    NON_EMPTY
    EMPTY
    STARTS_WITH
    ENDS_WITH
    CONTAINS
}

enum CompareOperatorNumeric {
    LESS_THAN
    LESS_EQUAL
    GREATER_THAN
    GREATER_EQUAL
}

enum CompareOperatorBool {
    TRUE
    FALSE
}

enum STTService {
    assembly_ai
    local_kyutai
    deepgram
    local_gabber
}

enum TTSService {
    cartesia
    elevenlabs
    openai
    minimax
    gabber
}

enum LLMService {
    openai_compatible
    mock
}

enum KittenTTSVoice {
    expr_voice_2_m
    expr_voice_2_f
    expr_voice_3_m
    expr_voice_3_f
    expr_voice_4_m
    expr_voice_4_f
    expr_voice_5_m
    expr_voice_5_f
}

enum VisemeType {
    SILENCE
    P
    B
    M
    O
    U
    F
    V
    T_D_N
    S_Z
    TH
    SH
    K_G
    L
    R
}

-- ============================================================================
-- PAD TYPES (value types for pad metadata)
-- ============================================================================

value StatelessSinkPad { id: String, group: String }
value StatelessSourcePad { id: String, group: String }
value PropertySinkPad { id: String, group: String }
value PropertySourcePad { id: String, group: String }

-- ============================================================================
-- CORE MEDIA NODES
-- ============================================================================

-- Combines audio and video clips into a single AV clip
entity AVClipZip {
    video_clip: StatelessSinkPad
    audio_clip: StatelessSinkPad
    av_clip: StatelessSourcePad
}

-- Controls frame rate by dropping or duplicating frames
entity FPS {
    input_video: StatelessSinkPad
    output_video: StatelessSourcePad
    fps_property: PropertySinkPad
}

-- Sliding window over media streams
entity SlidingWindow {
    input_media: StatelessSinkPad
    output_media: StatelessSourcePad
    window_size_property: PropertySinkPad
}

-- Publishes media with metadata
entity Publish {
    input_media: StatelessSinkPad
    output_media: StatelessSourcePad
    metadata_property: PropertySinkPad
}

-- Provides publisher metadata
entity PublisherMetadata {
    output_metadata: PropertySourcePad
}

-- Outputs audio and video to the end user
entity Output {
    audio: StatelessSinkPad
    video: StatelessSinkPad
}

-- ============================================================================
-- CORE LOGIC NODES
-- ============================================================================

-- Boolean AND operation on trigger inputs
entity AndNode {
    input_a: StatelessSinkPad
    input_b: StatelessSinkPad
    output: StatelessSourcePad
}

-- Boolean OR operation on trigger inputs
entity OrNode {
    input_a: StatelessSinkPad
    input_b: StatelessSinkPad
    output: StatelessSourcePad
}

-- Conditional gating of signals
entity Gate {
    input_signal: StatelessSinkPad
    gate_control: PropertySinkPad
    output: StatelessSourcePad
}

-- Filters values based on conditions
entity Filter {
    input_value: StatelessSinkPad
    condition_property: PropertySinkPad
    output_value: StatelessSourcePad
}

-- Comparison operations (LT, LE, EQ, NE, GE, GT)
entity Compare {
    input_a: StatelessSinkPad
    input_b: StatelessSinkPad
    operator_property: PropertySinkPad
    output: StatelessSourcePad
}

-- Enum-based switching between multiple outputs
entity EnumSwitch {
    input_trigger: StatelessSinkPad
    switch_value: PropertySinkPad
    outputs: Set<StatelessSourcePad>
}


-- Enum-based switching for property values
entity EnumSwitchProperty {
    sink: PropertySinkPad
    source: PropertySourcePad
    values: Set<PropertySinkPad>
}

-- Enum-based switching for trigger signals
entity EnumSwitchTrigger {
    sink: StatelessSinkPad
    outputs: Set<StatelessSourcePad>
}

-- ============================================================================
-- STATE MACHINE NODE
-- ============================================================================

-- Finite state machine controller with dynamic states and transitions
entity StateMachine {
    configuration: PropertySinkPad
    num_parameters: PropertySinkPad
    current_state: PropertySourcePad
    previous_state: PropertySourcePad
    parameter_names: List<PropertySinkPad>
    parameter_values: List<SinkPad>
}

entity StateMachineConfiguration {
    states: List<StateMachineState>
    transitions: List<StateMachineTransition>
    entry_state: String?
    entry_node_position: Point?
    special_any_state_position: Point?
}

entity StateMachineState {
    id: String
    name: String
    position: Point
}

entity StateMachineTransition {
    id: String
    from_state: String
    to_state: String
    conditions: List<StateMachineTransitionCondition>
}

entity StateMachineTransitionCondition {
    parameter_name: String?
    operator: String?
    value: Any?
}

-- ============================================================================
-- CORE SUBGRAPH NODES
-- ============================================================================

-- Embeds a subgraph within the parent graph
entity SubGraph {
    subgraph_id: PropertySinkPad
    proxy_pads: Set<ProxyPad>
}

-- Proxy property sink - exposes internal property sink to parent
entity ProxyPropertySink {
    pad: PropertySinkPad
    target_pad: Pad
}

-- Proxy property source - exposes internal property source to parent
entity ProxyPropertySource {
    pad: PropertySourcePad
    target_pad: Pad
}

-- Proxy stateless sink - exposes internal stateless sink to parent
entity ProxyStatelessSink {
    pad: StatelessSinkPad
    target_pad: Pad
}

-- Proxy stateless source - exposes internal stateless source to parent
entity ProxyStatelessSource {
    pad: StatelessSourcePad
    target_pad: Pad
}

-- ============================================================================
-- CORE TOOL NODES
-- ============================================================================

-- Model Context Protocol (MCP) tool integration
entity MCP {
    server_config: PropertySinkPad
    tool_name: PropertySinkPad
    input_arguments: PropertySinkPad
    output_result: PropertySourcePad
}

-- Groups multiple tools together
entity ToolGroup {
    tools: List<Tool>
    configuration: PropertySinkPad
}

-- ============================================================================
-- CORE TIMING NODES
-- ============================================================================

-- Delays signals by specified duration
entity Delay {
    input: StatelessSinkPad
    output: StatelessSourcePad
    delay_property: PropertySinkPad
}

-- Generates periodic triggers
entity Ticker {
    output: StatelessSourcePad
    interval_property: PropertySinkPad
}

-- ============================================================================
-- CORE PRIMITIVE NODES
-- ============================================================================

-- Stores and manages string values
entity StringNode {
    set: StatelessSinkPad
    emit: StatelessSinkPad
    value: PropertySourcePad
    changed: StatelessSourcePad
}

-- Stores and manages integer values
entity Integer {
    set: StatelessSinkPad
    emit: StatelessSinkPad
    value: PropertySourcePad
    changed: StatelessSourcePad
}

-- Stores and manages float values
entity Float {
    set: StatelessSinkPad
    emit: StatelessSinkPad
    value: PropertySourcePad
    changed: StatelessSourcePad
}

-- Stores and manages boolean values
entity Boolean {
    set: StatelessSinkPad
    emit: StatelessSinkPad
    value: PropertySourcePad
    changed: StatelessSourcePad
}

-- JSON data storage and manipulation
entity JSON {
    set_json: StatelessSinkPad
    emit: StatelessSinkPad
    value: PropertySourcePad
    changed: StatelessSourcePad
}

-- LLM context message management
entity ContextMessage {
    role: PropertySinkPad
    content: PropertySinkPad
    message: PropertySourcePad
}

entity ContextMessageValue {
    role: MessageRole
    content: List<ContentItem>
    tool_calls: List<ToolCall>?
    tool_call_id: String?
}

-- Creates context messages from multiple content inputs
entity ContextMessageZip {
    role: PropertySinkPad
    context_message: StatelessSourcePad
    num_contents: PropertySinkPad
    content: List<StatelessSinkPad>
}

-- Creates context messages for LLM conversations
entity CreateContextMessage {
    role: PropertySinkPad
    text_content: PropertySinkPad
    message_output: StatelessSourcePad
}

-- Stores variable references
entity Variable {
    set: StatelessSinkPad
    emit: StatelessSinkPad
    value: PropertySourcePad
    changed: StatelessSourcePad
}

-- Documentation/comment node (no functional behavior)
entity Comment {
    text: PropertySinkPad
    position: PropertySinkPad
}

-- ============================================================================
-- CORE UTILITY NODES
-- ============================================================================

-- Template rendering using Jinja2
entity Jinja2 {
    num_properties: PropertySinkPad
    jinja_template: PropertySinkPad
    property_names: List<PropertySinkPad>
    property_values: List<PropertySinkPad>
    property_value_sources: List<PropertySourcePad>
    rendered_output: PropertySourcePad
}

-- Merges multiple values into one
entity Merge {
    inputs: List<StatelessSinkPad>
    output: StatelessSourcePad
}

-- Converts between types automatically
entity AutoConvert {
    input: StatelessSinkPad
    target_type: PropertySinkPad
    output: StatelessSourcePad
}

-- Applies type constraints to values
entity TypeConstraint {
    input: StatelessSinkPad
    constraint_type: PropertySinkPad
    constraints: PropertySinkPad
    output: StatelessSourcePad
}

-- No operation node (passes through values unchanged)
entity Noop {
    input: StatelessSinkPad
    output: StatelessSourcePad
}

-- Demo node showing bouncing ball animation
entity BouncingBall {
    output_frame: StatelessSourcePad
    position: PropertySinkPad
    velocity: PropertySinkPad
}

-- Entry point for graph execution
entity Entry {
    output_trigger: StatelessSourcePad
}

-- Manually activate a trigger to run an action
entity ButtonTrigger {
    trigger: StatelessSourcePad
}

-- ============================================================================
-- CORE DEBUG NODES
-- ============================================================================

-- Interactive chat input for debugging
entity ChatInput {
    message_input: PropertySinkPad
    message_output: StatelessSourcePad
    send_trigger: StatelessSinkPad
}

-- Displays viseme data for debugging lip-sync
entity VisemeDebug {
    viseme_input: StatelessSinkPad
    display_value: PropertySourcePad
}

-- ============================================================================
-- STT NODES (Speech-to-Text)
-- ============================================================================

-- Generic STT node with multiple backend support
entity STT {
    service: PropertySinkPad
    audio: StatelessSinkPad
    speech_clip: StatelessSourcePad
    speech_started: StatelessSourcePad
    speech_ended: StatelessSourcePad
    final_transcription: StatelessSourcePad
    api_key: PropertySinkPad
    is_speaking: PropertySourcePad
}

-- Local Gabber STT node
entity LocalSTT {
    audio: StatelessSinkPad
    port: PropertySinkPad
    speech_clip: StatelessSourcePad
    speech_started: StatelessSourcePad
    speech_ended: StatelessSourcePad
    final_transcription: StatelessSourcePad
    is_speaking: PropertySourcePad
}

-- Multi-participant STT for distinguishing speakers
entity MultiParticipantSTT {
    audio: StatelessSinkPad
    participant_id: PropertySinkPad
    transcriptions: Set<StatelessSourcePad>
    speech_started: StatelessSourcePad
    speech_ended: StatelessSourcePad
}

-- VAD (Voice Activity Detection) node
entity VAD {
    audio: StatelessSinkPad
    speech_started: StatelessSourcePad
    speech_ended: StatelessSourcePad
    is_speaking: PropertySourcePad
    threshold: PropertySinkPad
}

-- Silero VAD - advanced voice activity detection with speech state tracking
entity SileroVAD {
    audio: StatelessSinkPad
    audio_clip: StatelessSourcePad
    speech_started_trigger: StatelessSourcePad
    speech_ended_trigger: StatelessSourcePad
    continued_speech_trigger: StatelessSourcePad
    vad_threshold: PropertySinkPad
    silence_duration_ms: PropertySinkPad
    speech_duration_ms: PropertySinkPad
    pre_speech_duration_ms: PropertySinkPad
}


-- ============================================================================
-- TTS NODES (Text-to-Speech)
-- ============================================================================

-- Generic TTS node with multiple backend support
entity TTS {
    service: PropertySinkPad
    text: StatelessSinkPad
    audio: StatelessSourcePad
    api_key: PropertySinkPad
    voice: PropertySinkPad
}

-- Cartesia TTS backend
entity CartesiaTTS {
    text: StatelessSinkPad
    audio: StatelessSourcePad
    api_key: PropertySinkPad
    voice: PropertySinkPad
}

-- ElevenLabs TTS backend
entity ElevenLabsTTS {
    text: StatelessSinkPad
    audio: StatelessSourcePad
    api_key: PropertySinkPad
    voice: PropertySinkPad
}

-- OpenAI TTS backend
entity OpenAITTS {
    text: StatelessSinkPad
    audio: StatelessSourcePad
    api_key: PropertySinkPad
    voice: PropertySinkPad
}

-- MiniMax TTS backend
entity MiniMaxTTS {
    text: StatelessSinkPad
    audio: StatelessSourcePad
    api_key: PropertySinkPad
    voice: PropertySinkPad
}

-- Gabber TTS backend (KittenTTS)
entity KittenTTS {
    voice_id: PropertySinkPad
    text: StatelessSinkPad
    audio: StatelessSourcePad
    cancel_trigger: StatelessSinkPad
    complete_transcription: StatelessSourcePad
    tts_started: StatelessSourcePad
    tts_ended: StatelessSourcePad
    is_talking: PropertySourcePad
}

-- ============================================================================
-- LLM NODES
-- ============================================================================

-- Generic LLM node with multiple backend support
entity LLM {
    service: PropertySinkPad
    system_message: PropertySinkPad
    messages: PropertySinkPad
    response: StatelessSourcePad
    api_key: PropertySinkPad
    model: PropertySinkPad
    temperature: PropertySinkPad
}

-- OpenAI-compatible LLM backend
entity OpenAICompatibleLLM {
    system_message: PropertySinkPad
    messages: PropertySinkPad
    response: StatelessSourcePad
    api_key: PropertySinkPad
    model: PropertySinkPad
    temperature: PropertySinkPad
    base_url: PropertySinkPad
}

-- Mock LLM for testing
entity MockLLM {
    system_message: PropertySinkPad
    messages: PropertySinkPad
    response: StatelessSourcePad
    mock_response: PropertySinkPad
}

-- Local LLM node (Qwen-omni)
entity LocalLLM {
    port: PropertySinkPad
    max_context_len: PropertySinkPad
    system_message: PropertySinkPad
    messages: PropertySinkPad
    response: StatelessSourcePad
    temperature: PropertySinkPad
}

-- Manages conversation context for language models with dynamic pruning
entity LLMContext {
    num_inserts: PropertySinkPad
    insert: List<StatelessSinkPad>
    new_user_message: StatelessSourcePad
    max_non_system_messages: PropertySinkPad
    max_videos: PropertySinkPad
    max_audios: PropertySinkPad
    max_images: PropertySinkPad
    system_message: PropertySinkPad
    source: PropertySourcePad
}


-- ============================================================================
-- LOCAL NODES
-- ============================================================================

-- Local viseme generation for lip-sync
entity LocalViseme {
    audio: StatelessSinkPad
    audio_src: StatelessSourcePad
    port: PropertySinkPad
    viseme: StatelessSourcePad
}

-- ============================================================================
-- NODE LIBRARY AND DISCOVERY
-- ============================================================================

-- Node library for discovering available node types
entity NodeLibrary {
    items: Set<LibraryItem>
}

entity LibraryItem {
    type: NodeType
    name: String
    description: String
    metadata: NodeMetadata
    pads: Set<PadDefinition>
}

entity PadDefinition {
    id: String
    type: BasePadType
    direction: Direction
    is_property: Boolean
    is_stateless: Boolean
    default_type_constraints: Set<PadConstraint>
}

enum Direction {
    Sink
    Source
}
