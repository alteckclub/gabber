-- allium: 2

use "./core.allium" as core
use "./engine.allium" as engine

-- Gabber Repository Service Specification
-- Distilled from engine/gabber/services/repository/
--
-- Scope: HTTP API for app and subgraph management
-- Includes: CRUD operations, import/export, secrets management, app execution
-- Excludes:
--   - Graph editor protocol (see editor.allium)
--   - Engine graph execution (see engine.allium)
--   - STT/TTS services (see services.allium)




-- ============================================================================
-- MODULE DECOMPOSITION
-- ============================================================================
-- The repository spec has been split into:
-- - repository_domain.allium: Pure domain rules (business logic)
-- - repository_persistence.allium: File I/O and storage operations
--
-- This separation improves testability and clarity by:
-- 1. Domain rules describe WHAT without implementation details
-- 2. Persistence rules describe HOW data is stored
-- 3. Domain rules can be tested without file system
-- 4. Storage backend can be swapped without changing domain logic
--
-- See repository_domain.allium and repository_persistence.allium for details

-- ============================================================================
-- SERVICE ARCHITECTURE
-- ============================================================================

-- The Repository Service is an HTTP server that manages apps and subgraphs.
-- It provides persistent storage, import/export functionality, and app execution.

entity RepositoryServer {
    port: Integer               -- HTTP server port (default: 8001)
    file_path: String           -- Root directory for repository data
    app: HTTPApplication
    secret_provider: SecretProvider
}

-- ============================================================================
-- DATA MODELS
-- ============================================================================

-- Core entities stored in the repository

entity RepositoryApp {
    id: String                  -- UUID identifier
    name: String                -- Human-readable name
    created_at: Timestamp
    updated_at: Timestamp
    graph: GraphEditorRepresentation  -- The app's graph definition
}

entity RepositorySubGraph {
    id: String                  -- UUID identifier
    name: String                -- Human-readable name
    created_at: Timestamp
    updated_at: Timestamp
    graph: GraphEditorRepresentation  -- The subgraph's graph definition
}

-- Export formats for import/export operations

entity AppExport {
    app: RepositoryApp
    subgraphs: List<RepositorySubGraph>  -- Associated subgraphs
}

entity SubGraphExport {
    subgraph: RepositorySubGraph
    nested_subgraphs: List<RepositorySubGraph>  -- Nested subgraph dependencies
}

-- Connection details for app execution

entity AppRunConnectionDetails {
    url: String                 -- LiveKit server URL
    token: String               -- JWT token for authentication
}

-- Secret management

entity PublicSecret {
    name: String                -- Secret identifier
    value: String               -- Secret value (masked in responses)
}

-- ============================================================================
-- HTTP API ENDPOINTS
-- ============================================================================

-- The Repository Service exposes the following HTTP endpoints using aiohttp.
-- All endpoints support CORS from any origin.

-- ============================================================================
-- APP ENDPOINTS
-- ============================================================================

-- List all apps
-- GET /app/list
-- Returns: ListAppsResponse

rule AppListApps {
    when: GET /app/list

    ensures:
        app_dir = file_path + "/app"
        files = list_directory(app_dir)
        apps = Set<RepositoryApp>
        for file in files:
            if file.endswith(".json"):
                content = read_file(file_path + "/app/" + file)
                app = RepositoryApp.parse_json(content)
                apps.add(app)
        sorted_apps = sort_by_created_at_desc(apps)
        ListAppsResponse.created(apps: sorted_apps)
}

-- Get a specific app
-- GET /app/{id}
-- Returns: GetAppResponse
-- Errors: 404 if app not found

rule AppGetApp {
    when: GET /app/{id}

    requires: length(id) = 36

    ensures:
        file_path = file_path + "/app/" + id + ".json"
        if file_exists(file_path):
            content = read_file(file_path)
            app = RepositoryApp.parse_json(content)
            GetAppResponse.created(app: app)
        if not file_exists(file_path):
            HTTPResponse.created(status: 404)
}

-- Create or update an app
-- POST /app
-- Body: SaveAppRequest
-- Returns: SaveAppResponse

rule AppSaveApp {
    when: POST /app with SaveAppRequest

    ensures:
        if request.id != null:
            existing_app = load_app(request.id)
            if existing_app != null:
                existing_app.name = request.name
                existing_app.graph = request.graph
                existing_app.updated_at = now()
                save_app(existing_app)
                SaveAppResponse.created(app: existing_app)
            if existing_app = null:
                HTTPResponse.created(status: 404)
        if request.id = null:
            new_app = RepositoryApp.created(
                id: generate_uuid(),
                name: request.name,
                graph: request.graph,
                created_at: now(),
                updated_at: now()
            )
            save_app(new_app)
            SaveAppResponse.created(app: new_app)
}

-- Delete an app
-- DELETE /app/{id}
-- Returns: Success response
-- Errors: 404 if app not found

rule AppDeleteApp {
    when: DELETE /app/{id}

    ensures:
        file_path = file_path + "/app/" + id + ".json"
        if file_exists(file_path):
            delete_file(file_path)
            HTTPResponse.created(status: 200)
        if not file_exists(file_path):
            HTTPResponse.created(status: 404)
}

-- Import an app with its subgraphs
-- POST /app/import
-- Body: AppExport
-- Returns: SaveAppResponse

rule AppImportApp {
    when: POST /app/import with AppExport

    ensures:
        mapping = Map<String, String>

        -- Import all subgraphs first
        for sg in export.subgraphs:
            new_sg = import_subgraph_with_id_conflict_resolution(sg)
            if sg.id != new_sg.id:
                mapping.put(sg.id, new_sg.id)

        -- Import the app
        new_app = import_app_with_id_conflict_resolution(export.app)

        -- Update graph references to use new subgraph IDs
        if mapping != {}:
            update_graph_subgraph_references(new_app.graph, mapping)

        SaveAppResponse.created(app: new_app)
}

-- Export an app with its subgraphs
-- GET /app/{id}/export
-- Returns: ExportAppResponse

rule AppExportApp {
    when: GET /app/{id}/export

    ensures:
        app = load_app(id)

        -- Extract subgraph IDs referenced by the app
        subgraph_ids = extract_subgraph_ids(app.graph)

        -- Load all referenced subgraphs
        subgraphs = Set<RepositorySubGraph>
        for sg_id in subgraph_ids:
            sg = load_subgraph(sg_id)
            if sg != null:
                -- Remove secret options for security
                sg.graph = strip_secret_options(sg.graph)
                subgraphs.add(sg)

        -- Remove secret options from app
        app.graph = strip_secret_options(app.graph)

        ExportAppResponse.created(export: AppExport.created(app: app, subgraphs: subgraphs))
}

-- ============================================================================
-- SUBGRAPH ENDPOINTS
-- ============================================================================

-- List all subgraphs
-- GET /sub_graph/list
-- Returns: ListSubgraphsResponse

rule SubgraphListSubgraphs {
    when: GET /sub_graph/list

    ensures:
        subgraph_dir = file_path + "/sub_graph"
        files = list_directory(subgraph_dir)
        subgraphs = Set<RepositorySubGraph>
        for file in files:
            if file.endswith(".json"):
                content = read_file(file_path + "/sub_graph/" + file)
                subgraph = RepositorySubGraph.parse_json(content)
                subgraphs.add(subgraph)
        sorted_subgraphs = sort_by_created_at_desc(subgraphs)
        ListSubgraphsResponse.created(sub_graphs: sorted_subgraphs)
}

-- Get a specific subgraph
-- GET /sub_graph/{id}
-- Returns: GetSubgraphResponse
-- Errors: 404 if subgraph not found

rule SubgraphGetSubgraph {
    when: GET /sub_graph/{id}

    requires: length(id) = 36

    ensures:
        file_path = file_path + "/sub_graph/" + id + ".json"
        if file_exists(file_path):
            content = read_file(file_path)
            subgraph = RepositorySubGraph.parse_json(content)
            GetSubgraphResponse.created(sub_graph: subgraph)
        if not file_exists(file_path):
            HTTPResponse.created(status: 404)
}

-- Create or update a subgraph
-- POST /sub_graph
-- Body: SaveSubgraphRequest
-- Returns: SaveSubgraphResponse

rule SubgraphSaveSubgraph {
    when: POST /sub_graph with SaveSubgraphRequest

    ensures:
        if request.id != null:
            existing_sg = load_subgraph(request.id)
            if existing_sg != null:
                existing_sg.name = request.name
                existing_sg.graph = request.graph
                existing_sg.updated_at = now()
                save_subgraph(existing_sg)
                SaveSubgraphResponse.created(sub_graph: existing_sg)
            if existing_sg = null:
                HTTPResponse.created(status: 404)
        if request.id = null:
            new_sg = RepositorySubGraph.created(
                id: generate_uuid(),
                name: request.name,
                graph: request.graph,
                created_at: now(),
                updated_at: now()
            )
            save_subgraph(new_sg)
            SaveSubgraphResponse.created(sub_graph: new_sg)
}

-- Delete a subgraph
-- DELETE /sub_graph/{id}
-- Returns: Success response
-- Errors: 404 if subgraph not found

rule SubgraphDeleteSubgraph {
    when: DELETE /sub_graph/{id}

    ensures:
        file_path = file_path + "/sub_graph/" + id + ".json"
        if file_exists(file_path):
            delete_file(file_path)
            HTTPResponse.created(status: 200)
        if not file_exists(file_path):
            HTTPResponse.created(status: 404)
}

-- Import a subgraph with nested subgraphs
-- POST /sub_graph/import
-- Body: SubGraphExport
-- Returns: SaveSubgraphResponse

rule SubgraphImportSubgraph {
    when: POST /sub_graph/import with SubGraphExport

    ensures:
        mapping = Map<String, String>

        -- Import all nested subgraphs first
        for sg in export.nested_subgraphs:
            new_sg = import_subgraph_with_id_conflict_resolution(sg)
            if sg.id != new_sg.id:
                mapping.put(sg.id, new_sg.id)

        -- Import the main subgraph
        new_sg = import_subgraph_with_id_conflict_resolution(export.subgraph)

        -- Update graph references to use new subgraph IDs
        if mapping != {}:
            update_graph_subgraph_references(new_sg.graph, mapping)

        SaveSubgraphResponse.created(sub_graph: new_sg)
}

-- Export a subgraph with nested subgraphs
-- GET /sub_graph/{id}/export
-- Returns: ExportSubGraphResponse

rule SubgraphExportSubgraph {
    when: GET /sub_graph/{id}/export

    ensures:
        subgraph = load_subgraph(id)

        -- Recursively extract all nested subgraph IDs
        subgraph_ids = extract_all_nested_subgraph_ids(subgraph.graph)

        -- Load all nested subgraphs
        nested_subgraphs = Set<RepositorySubGraph>
        processed_ids = Set<String>
        for sg_id in subgraph_ids:
            if sg_id not in processed_ids:
                sg = load_subgraph(sg_id)
                if sg != null:
                    sg.graph = strip_secret_options(sg.graph)
                    nested_subgraphs.add(sg)
                    processed_ids.add(sg_id)

        -- Remove secret options from main subgraph
        subgraph.graph = strip_secret_options(subgraph.graph)

        ExportSubGraphResponse.created(export: SubGraphExport.created(
            subgraph: subgraph,
            nested_subgraphs: nested_subgraphs
        ))
}

-- ============================================================================
-- EXAMPLE ENDPOINTS (Read-only, from data/ directory)
-- ============================================================================

-- List example apps
-- GET /example/list
-- Returns: ListAppsResponse

rule ExampleListExamples {
    when: GET /example/list

    ensures:
        example_dir = "data/example"
        files = list_directory(example_dir)
        apps = Set<RepositoryApp>
        for file in files:
            if file.endswith(".json"):
                content = read_file(example_dir + "/" + file)
                app = RepositoryApp.parse_json(content)
                apps.add(app)
        sorted_apps = sort_by_created_at_desc(apps)
        ListAppsResponse.created(apps: sorted_apps)
}

-- Get a specific example
-- GET /example/{id}
-- Returns: GetAppResponse
-- Errors: 404 if example not found

rule ExampleGetExample {
    when: GET /example/{id}

    ensures:
        file_path = "data/example/" + id + ".json"
        if file_exists(file_path):
            content = read_file(file_path)
            app = RepositoryApp.parse_json(content)
            GetAppResponse.created(app: app)
        if not file_exists(file_path):
            HTTPResponse.created(status: 404)
}

-- ============================================================================
-- PREMADE SUBGRAPH ENDPOINTS (Read-only, from data/ directory)
-- ============================================================================

-- List premade subgraphs
-- GET /premade_subgraph/list
-- Returns: ListSubgraphsResponse

rule PremadeSubgraphListPremadeSubgraphs {
    when: GET /premade_subgraph/list

    ensures:
        subgraph_dir = "data/sub_graph"
        files = list_directory(subgraph_dir)
        subgraphs = Set<RepositorySubGraph>
        for file in files:
            if file.endswith(".json"):
                content = read_file(subgraph_dir + "/" + file)
                subgraph = RepositorySubGraph.parse_json(content)
                subgraphs.add(subgraph)
        sorted_subgraphs = sort_by_created_at_desc(subgraphs)
        ListSubgraphsResponse.created(sub_graphs: sorted_subgraphs)
}

-- Get a specific premade subgraph
-- GET /premade_subgraph/{id}
-- Returns: GetSubgraphResponse
-- Errors: 404 if subgraph not found

rule PremadeSubgraphGetPremadeSubgraph {
    when: GET /premade_subgraph/{id}

    ensures:
        file_path = "data/sub_graph/" + id + ".json"
        if file_exists(file_path):
            content = read_file(file_path)
            subgraph = RepositorySubGraph.parse_json(content)
            GetSubgraphResponse.created(sub_graph: subgraph)
        if not file_exists(file_path):
            HTTPResponse.created(status: 404)
}

-- ============================================================================
-- APP EXECUTION ENDPOINTS
-- ============================================================================

-- Create a new app run (LiveKit room with agent dispatch)
-- POST /app/run
-- Body: CreateAppRunRequest
-- Returns: CreateAppRunResponse

rule AppRun {
    when: POST /app/run with CreateAppRunRequest

    ensures:
        -- Create LiveKit room with agent dispatch
        room_name = request.run_id

        -- Encode graph as base64 gzip for metadata
        graph_json = request.graph.model_dump_json()
        compressed = gzip_compress(graph_json)
        metadata_b64 = base64_encode(compressed)

        -- Create LiveKit room
        room = livekit_api.create_room(
            name: room_name,
            agents: {
                RoomAgentDispatch.created(
                    agent_name: "gabber-engine",
                    metadata: metadata_b64
                )
            }
        )

        -- Generate access token
        token = livekit_api.generate_token(
            room: room_name,
            grants: VideoGrants.created(
                room_join: true,
                can_publish: true,
                can_subscribe: true
            ),
            identity: "human-" + short_uuid()
        )

        CreateAppRunResponse.created(
            connection_details: AppRunConnectionDetails.created(
                url: livekit_url,
                token: token
            )
        )
}

-- Get debug connection details
-- POST /app/debug_connection
-- Body: DebugConnectionRequest
-- Returns: DebugConnectionResponse

rule AppDebugConnection {
    when: POST /app/debug_connection with DebugConnectionRequest

    ensures:
        -- List room dispatches to find gabber-engine
        dispatches = livekit_api.list_dispatch(room_name: request.run_id)
        dispatch = find_dispatch(dispatches, "gabber-engine")

        -- Extract graph from dispatch metadata
        metadata = parse_json(dispatch.metadata)
        graph = GraphEditorRepresentation.parse(metadata.graph)

        -- Generate debug token (read-only, can publish data)
        token = livekit_api.generate_token(
            room: request.run_id,
            grants: VideoGrants.created(
                room_join: true,
                can_publish: false,
                can_publish_data: true,
                can_subscribe: true
            ),
            identity: "debug"
        )

        DebugConnectionResponse.created(
            connection_details: AppRunConnectionDetails.created(
                url: livekit_url,
                token: token
            ),
            graph: graph
        )
}

-- Get MCP proxy connection details
-- POST /app/mcp_proxy_connection
-- Body: MCPProxyConnectionRequest
-- Returns: MCPProxyConnectionResponse

rule AppMCPProxyConnection {
    when: POST /app/mcp_proxy_connection with MCPProxyConnectionRequest

    ensures:
        -- Generate MCP proxy token (read-only, can publish data)
        token = livekit_api.generate_token(
            room: request.run_id,
            grants: VideoGrants.created(
                room_join: true,
                can_publish: false,
                can_publish_data: true,
                can_subscribe: true
            ),
            identity: "mcp_proxy"
        )

        MCPProxyConnectionResponse.created(
            connection_details: AppRunConnectionDetails.created(
                url: livekit_url,
                token: token
            )
        )
}

-- ============================================================================
-- SECRET MANAGEMENT ENDPOINTS
-- ============================================================================

-- List all secret names
-- GET /secret/list
-- Returns: ListSecretsResponse

rule SecretListSecrets {
    when: GET /secret/list

    ensures:
        secrets = secret_provider.list_secrets()
        ListSecretsResponse.created(secrets: secrets)
}

-- Add a new secret
-- POST /secret
-- Body: AddSecretRequest
-- Returns: AddSecretResponse

rule SecretAddSecret {
    when: POST /secret with AddSecretRequest

    ensures:
        secrets = secret_provider.read_secrets()
        secrets.put(request.name, request.value)
        secret_provider.write_secrets(secrets)
        AddSecretResponse.created(success: true)
}

-- Update an existing secret
-- PUT /secret/{name}
-- Body: UpdateSecretRequest
-- Returns: UpdateSecretResponse
-- Errors: 404 if secret not found

rule SecretUpdateSecret {
    when: PUT /secret/{name} with UpdateSecretRequest

    ensures:
        secrets = secret_provider.read_secrets()
        if name not in secrets:
            HTTPResponse.created(status: 404)
        if name in secrets:
            secrets.put(name, request.value)
            secret_provider.write_secrets(secrets)
            UpdateSecretResponse.created(success: true)
}

-- Delete a secret
-- DELETE /secret/{name}
-- Returns: DeleteSecretResponse
-- Errors: 404 if secret not found

rule SecretDeleteSecret {
    when: DELETE /secret/{name}

    ensures:
        secrets = secret_provider.read_secrets()
        if name not in secrets:
            HTTPResponse.created(status: 404)
        if name in secrets:
            secrets.remove(name)
            secret_provider.write_secrets(secrets)
            DeleteSecretResponse.created(success: true)
}

-- ============================================================================
-- HELPER FUNCTIONS
-- ============================================================================

-- Import subgraph with ID conflict resolution

rule import_subgraph_with_id_conflict_resolution {
    input: RepositorySubGraph
    output: RepositorySubGraph

    ensures:
        new_id = resolve_unique_id(request.id, subgraph_exists)
        new_name = resolve_unique_name(request.name, get_all_subgraph_names())
        RepositorySubGraph.created(
            id: new_id,
            name: new_name,
            graph: request.graph,
            created_at: now(),
            updated_at: now()
        )
}

-- Import app with ID conflict resolution

rule import_app_with_id_conflict_resolution {
    input: RepositoryApp
    output: RepositoryApp

    ensures:
        new_id = resolve_unique_id(request.id, app_exists)
        new_name = resolve_unique_name(request.name, get_all_app_names())
        RepositoryApp.created(
            id: new_id,
            name: new_name,
            graph: request.graph,
            created_at: now(),
            updated_at: now()
        )
}

-- Extract subgraph IDs from a graph

rule extract_subgraph_ids {
    input: GraphEditorRepresentation
    output: Set<String>

    ensures:
        ids = Set<String>
        for node in graph.nodes:
            if node.type = "SubGraph":
                id_pad = find_pad(node.pads, "__subgraph_id__")
                if id_pad.value.type = String:
                    ids.add(id_pad.value.value)
        ids
}

-- Extract all nested subgraph IDs recursively

rule extract_all_nested_subgraph_ids {
    input: GraphEditorRepresentation
    output: Set<String>

    ensures:
        nested = collect_all_subgraph_ids(graph)
        nested
}

-- Update graph subgraph references using ID mapping

rule update_graph_subgraph_references {
    input: GraphEditorRepresentation, mapping: Map<String, String>
    output: GraphEditorRepresentation

    ensures:
        updated_graph = apply_id_mapping(graph, mapping)
        updated_graph
}

-- ============================================================================
-- REQUEST/RESPONSE SCHEMAS
-- ============================================================================

-- Request types
-- Request types used by HTTP API endpoints.
-- Each request type corresponds to a specific endpoint operation.

entity SaveSubgraphRequest {
-- Usage: POST /sub_graph with SaveSubgraphRequest creates a new subgraph
--        POST /sub_graph with id set updates an existing subgraph
-- Example: { "type": "SaveSubgraphRequest", "name": "my-subgraph", "graph": {...} }
    type: String
    id: String?                 -- Optional for updates
    name: String
    graph: GraphEditorRepresentation
}

entity SaveAppRequest {
-- Usage: POST /app creates a new app (id=null) or updates existing (id set)
-- Example: { "type": "SaveAppRequest", "name": "my-app", "graph": {...} }
    type: String
    id: String?                 -- Optional for updates
    name: String
    graph: GraphEditorRepresentation
}

entity CreateAppRunRequest {
-- Usage: POST /app/run to start app execution in a LiveKit room
-- The run_id becomes the room name, graph is encoded into room metadata
-- Example: { "type": "CreateAppRunRequest", "run_id": "session-123", "graph": {...} }
    type: String
    run_id: String              -- Room name/ID
    graph: GraphEditorRepresentation
}

entity DebugConnectionRequest {
-- Usage: POST /app/debug_connection to get read-only access for debugging
-- Returns connection details plus the current graph state from the running app
-- Example: { "type": "DebugConnectionRequest", "run_id": "session-123" }
    type: String
    run_id: String
}

entity MCPProxyConnectionRequest {
-- Usage: POST /app/mcp_proxy_connection to enable MCP server connections
-- Returns credentials for MCP proxy client to join the app's LiveKit room
-- Example: { "type": "MCPProxyConnectionRequest", "run_id": "session-123" }
    type: String
    run_id: String
}

entity ImportAppRequest {
-- Usage: POST /app/import to restore an app from export
-- Reconstructs app and all subgraphs with ID conflict resolution
-- Example: { "type": "ImportAppRequest", "export": AppExport {...} }
    type: String
    export: AppExport
}

entity ImportSubGraphRequest {
-- Usage: POST /sub_graph/import to restore subgraph with nested dependencies
-- Recursively imports all nested subgraphs with ID conflict resolution
-- Example: { "type": "ImportSubGraphRequest", "export": SubGraphExport {...} }
    type: String
    export: SubGraphExport
}

entity AddSecretRequest {
-- Usage: POST /secret to add a new secret (e.g., API key for node configuration)
-- Secret values are stored encrypted and referenced by nodes via secret_id
-- Example: { "type": "AddSecretRequest", "name": "OPENAI_API_KEY", "value": "sk-..." }
    type: String
    name: String
    value: String
}

entity UpdateSecretRequest {
-- Usage: PUT /secret/{name} to update an existing secret's value
-- Returns 404 if secret name doesn't exist
-- Example: { "type": "UpdateSecretRequest", "value": "sk-newvalue" }
    type: String
    value: String
}

-- Response types
-- Response types returned by HTTP API endpoints.
-- Each response includes a type field for client deserialization.

entity GetAppResponse {
-- Returned by: GET /app/{id}
-- Contains full app details including graph definition
    type: String
    app: RepositoryApp
}

entity SaveAppResponse {
-- Returned by: POST /app (create/update)
-- On success: returns saved app with generated/confirmed ID
-- On update failure: returns 404 if app doesn't exist
    type: String
    app: RepositoryApp
}

entity ListAppsResponse {
-- Returned by: GET /app/list, GET /example/list
-- Apps sorted by created_at descending (newest first)
    type: String
    apps: List<RepositoryApp>
}

entity GetSubgraphResponse {
-- Returned by: GET /sub_graph/{id}, GET /premade_subgraph/{id}
-- Contains full subgraph details including graph definition
    type: String
    sub_graph: RepositorySubGraph
}

entity SaveSubgraphResponse {
-- Returned by: POST /sub_graph (create/update)
-- On success: returns saved subgraph with generated/confirmed ID
    type: String
    sub_graph: RepositorySubGraph
}

entity ListSubgraphsResponse {
-- Returned by: GET /sub_graph/list, GET /premade_subgraph/list
-- Subgraphs sorted by created_at descending (newest first)
    type: String
    sub_graphs: List<RepositorySubGraph>
}

entity CreateAppRunResponse {
-- Returned by: POST /app/run
-- Connection details include LiveKit URL and JWT token for room access
-- Token grants: room_join, can_publish, can_subscribe
    type: String
    connection_details: AppRunConnectionDetails
}

entity DebugConnectionResponse {
-- Returned by: POST /app/debug_connection
-- Token grants: room_join, can_subscribe, can_publish_data (read-only video, data channel write)
    type: String
    connection_details: AppRunConnectionDetails
    graph: GraphEditorRepresentation
}

entity MCPProxyConnectionResponse {
-- Returned by: POST /app/mcp_proxy_connection
-- Token grants: room_join, can_subscribe, can_publish_data (for MCP traffic)
    type: String
    connection_details: AppRunConnectionDetails
}

entity ExportAppResponse {
-- Returned by: GET /app/{id}/export
-- Includes app and all subgraphs referenced in the app's graph
    type: String
    export: AppExport
}

entity ExportSubGraphResponse {
-- Returned by: GET /sub_graph/{id}/export
-- Recursively includes all nested subgraphs referenced transitively
    type: String
    export: SubGraphExport
}

entity ListSecretsResponse {
-- Returned by: GET /secret/list
-- Returns only secret names, not values (security)
    type: String
    secrets: List<PublicSecret>
}

entity AddSecretResponse {
-- Returned by: POST /secret
-- On success: secret stored in .secret file
-- May fail if secret name conflicts or write fails
    type: String
    success: Boolean
}

entity UpdateSecretResponse {
-- Returned by: PUT /secret/{name}
-- On success: secret value updated
-- On failure: returns 404 if name not found
    type: String
    success: Boolean
}

entity DeleteSecretResponse {
-- Returned by: DELETE /secret/{name}
-- On success: secret removed from .secret file
-- On failure: returns 404 if name not found
    type: String
    success: Boolean
}

-- ============================================================================
-- ERROR HANDLING
-- ============================================================================

-- Standard error responses

entity ErrorResponse {
    status: String
    message: String
}

-- HTTP Status Codes Used:
-- - 200: Success
-- - 400: Bad Request (invalid input)
-- - 404: Not Found (resource doesn't exist)
-- - 500: Internal Server Error

-- ============================================================================
-- SECURITY CONSIDERATIONS
-- ============================================================================

-- Secrets are stripped from exported graphs to prevent credential leakage
-- All endpoints support CORS for frontend access
-- LiveKit tokens provide scoped access to specific rooms
-- Secret values are stored in a .secret file (should be gitignored)
