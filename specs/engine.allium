-- allium: 2

use "./core.allium" as core

-- Gabber Engine Specification
-- Distilled from engine/gabber/ implementation
-- ============================================================================
-- SCOPE: Graph Execution Engine
-- ============================================================================
-- This spec defines the core graph execution engine for Gabber.
--
-- INCLUDES:
--   - Graph model and node execution lifecycle
--   - Pad connection and type constraint system
--   - Runtime data types and value propagation
--   - State machine node execution
--   - Subgraph composition
--   - Request context and item handling
--
-- RELATIONSHIP TO OTHER SPECS:
--   - Node libraries: see nodes.allium (node type definitions)
--   - Library configs: see lib.allium (LLM, STT, TTS backends)
--   - Service implementations: see services.allium (audio services)
--   - Editor protocol: see editor.allium (graph edit protocol)
--   - System architecture: see architecture.allium (EngineService)
--
-- EXCLUDES:
--   - Specific node implementations: see nodes.allium
--   - Editor WebSocket protocol: see editor.allium
--   - Repository service: see repository.allium
--   - LiveKit/WebRTC details: see livekit.allium
--   - MCP integration: see mcp.allium
-- Scope: Core graph execution engine for real-time AI applications
-- Includes: Graph model, node execution, pad communication, type system
-- Excludes:
--   - Specific node implementations (STT, TTS, LLM nodes) - these are library specs
--   - Editor service communication protocols - separate spec
--   - Repository service - separate spec
--   - LiveKit/WebRTC integration details - implementation mechanism
--   - MCP (Model Context Protocol) integration - library spec

-- ============================================================================
-- CORE CONCEPTS
-- ============================================================================

-- The Gabber Engine executes real-time AI applications as directed graphs of
-- interconnected nodes. Data flows through typed connection points (pads)
-- between nodes, enabling composition of AI capabilities.

-- An application is a graph of nodes that processes audio, video, and text
-- in real-time. The engine manages node lifecycle, data flow, and execution.

entity Application {
    id: String
    graph: Graph
    status: running | stopped
}

-- ============================================================================
-- GRAPH MODEL
-- ============================================================================

-- A Graph is a directed network of nodes connected via pads.
-- Graphs can be nested (sub-graphs) for composition.

-- Graph, Node, Pad, Connection, Portal, and related types are defined in core.allium

-- ============================================================================
-- NODE SYSTEM
-- ============================================================================

-- Nodes are the fundamental building blocks of AI applications.
-- Each node performs a specific function (e.g., STT, TTS, LLM, logic).


-- ============================================================================
-- PAD SYSTEM (CONNECTION POINTS)
-- ============================================================================

-- Pads are typed connection points on nodes. Data flows from source pads
-- to sink pads through explicit connections.


-- ============================================================================
-- RUNTIME DATA TYPES
-- ============================================================================

-- Values that flow through pads during execution

-- RuntimeValue and variants are defined in core.allium

-- AudioClip, AudioFrame, AudioData, VideoFrame, VideoClip, AVClip, TextStream are defined in core.allium

-- Function definition for LLM tool use
entity ToolDefinition {
    name: String
    description: String
    parameters: JsonObject?
    destination: ToolDestination
}

enum ToolDestination { Webhook | Client }

-- Lip-sync animation data (Viseme and VisemeType defined in core.allium)
entity Viseme {
    value: VisemeType
}

-- ============================================================================
-- PAD CONNECTIONS AND DATA FLOW
-- ============================================================================

-- Pads connect to form data paths through the graph
entity PadConnection {
    source_pad: Pad
    target_pad: Pad
}

-- Rules for pad connections
rule ConnectPads {
    when: SourcePad.connect(target: SinkPad)

    requires: source_pad.can_connect(target)

    ensures: PadConnection.created(
        source: source_pad,
        target: target
    )
    ensures: target_pad.set_previous_pad(source_pad)
    ensures: source_pad.add_next_pad(target)
}

-- Type compatibility check for connections
rule PadTypeCompatibility {
    when: source_pad.can_connect(target: SinkPad)

    requires: target.get_previous_pad() = null   -- Single input constraint

    ensures:
        intersection = INTERSECTION(
            source_pad.get_type_constraints(),
            target.get_type_constraints()
        )
    ensures: intersection != empty

    -- Type constraints propagate through connected pads
    ensures:
        for p in connected_pad_cluster(source_pad):
            p.set_type_constraints(intersection)
}


-- ============================================================================
-- TYPE CONSTRAINT HELPERS
-- ============================================================================


-- Compute intersection of type constraint sets
-- Semantic: Returns the set of type constraints that are common to both input sets.
-- Used to determine if two pads can connect (intersection must be non-empty).
-- Example: INTERSECTION({String, Integer}, {String, Boolean}) = {String}
rule INTERSECTION {
    -- Type signature: INTERSECTION(Set<TypeConstraint>, Set<TypeConstraint>) -> Set<TypeConstraint>
    -- Complexity: O(n * m) where n, m are sizes of input sets
    when: INTERSECTION(set1: Set<TypeConstraint>, set2: Set<TypeConstraint>)

    ensures:
        -- The intersection contains only types present in both sets
        result = Set<TypeConstraint>
        for tc in set1:
            if tc in set2:
                result.add(tc)
        result
}


-- Get all pads connected in the same cluster
-- Semantic: Returns all pads reachable from the input pad through connections.
-- Uses breadth-first search to find the transitive closure of connected pads.
-- Used for propagating type constraints across a connected pad cluster.
-- Example: connected_pad_cluster(pad_a) = {pad_a, pad_b, pad_c} if they are all connected
rule connected_pad_cluster {
    -- Type signature: connected_pad_cluster(Pad) -> Set<Pad>
    -- Complexity: O(v + e) where v is pads in cluster, e is connections
    when: connected_pad_cluster(pad: Pad)

    ensures:
        -- Collect all pads reachable through connections
        cluster = Set<Pad>
        visited = Set<Pad>
        queue = List<Pad>
        queue.add(pad)
        for _ in range(queue.count):
            current = queue.pop()
            if current not in visited:
                visited.add(current)
                cluster.add(current)
                for next in current.get_next_pads():
                    queue.add(next)
                for prev in current.get_previous_pads():
                    queue.add(prev)
        cluster
}


-- Pad type constraint operations
-- These describe the semantics of type constraint propagation
rule pad_get_type_constraints {
    -- Type signature: pad.get_type_constraints() -> Set<TypeConstraint>
    when: pad.get_type_constraints()

    ensures: pad._type_constraints
}


rule pad_set_type_constraints {
    -- Type signature: pad.set_type_constraints(Set<TypeConstraint>) -> Unit
    when: pad.set_type_constraints(constraints: Set<TypeConstraint>)

    ensures: pad._type_constraints = constraints
}


rule pad_get_default_type_constraints {
    -- Type signature: pad.get_default_type_constraints() -> Set<TypeConstraint>
    when: pad.get_default_type_constraints()

    ensures: pad._default_type_constraints
}


-- ============================================================================
-- PAD CONNECTION HELPERS
-- ============================================================================


-- ============================================================================
-- PAD CONNECTION HELPERS
-- ============================================================================


-- Check if a pad can connect to another
-- Semantic: Returns true if type constraints have non-empty intersection
rule pad_can_connect {
    -- Type signature: source_pad.can_connect(SinkPad) -> Boolean
    when: source_pad.can_connect(target: SinkPad)

    ensures:
        intersection = INTERSECTION(
            source_pad.get_type_constraints(),
            target.get_type_constraints()
        )
        intersection != empty
}


-- Pad navigation operations
rule pad_get_previous_pad {
    -- Type signature: pad.get_previous_pad() -> Pad?
    when: pad.get_previous_pad()

    ensures: pad._previous_pad
}


rule pad_get_next_pads {
    -- Type signature: pad.get_next_pads() -> Set<Pad>
    when: pad.get_next_pads()

    ensures: pad._next_pads
}


rule pad_set_previous_pad {
    -- Type signature: pad.set_previous_pad(Pad?) -> Unit
    when: pad.set_previous_pad(previous_pad: Pad?)

    ensures: pad._previous_pad = previous_pad
}


rule pad_add_next_pad {
    -- Type signature: pad.add_next_pad(Pad) -> Unit
    when: pad.add_next_pad(next_pad: Pad)

    ensures: pad._next_pads.add(next_pad)
}


-- ============================================================================
-- REQUEST CONTEXT HELPERS
-- ============================================================================


-- ============================================================================
-- REQUEST CONTEXT HELPERS
-- ============================================================================


-- Create new context
rule request_context_new {
    -- Type signature: new_context(RequestContext?) -> RequestContext
    when: new_context(parent: RequestContext)

    ensures:
        RequestContext.created(
            parent: parent,
            timeout: parent.timeout,
            originator: "generated",
            publisher_metadata: parent.publisher_metadata
        )
}


-- Complete request context
rule request_context_complete {
    -- Type signature: ctx.complete() -> Unit
    when: ctx.complete()

    ensures: ctx._complete = true
}


-- ============================================================================
-- ITEM AND VALUE HELPERS
-- ============================================================================


-- Create item with value and context
rule item_create {
    -- Type signature: Item.created(RuntimeValue, RequestContext) -> Item
    when: Item.created(value: RuntimeValue, ctx: RequestContext)

    ensures:
        Item(value: value, ctx: ctx)
}


-- Queue operations
rule queue_put {
    -- Type signature: queue.put(Item) -> Unit
    when: queue.put(item: Item)

    ensures: queue.add(item)
}


-- Get queue from sink pad
rule sink_pad_get_queue {
    -- Type signature: sink_pad._get_queue() -> Queue<Item>
    when: sink_pad._get_queue()

    ensures: sink_pad._queue
}


-- Data flows from source to all connected sinks
rule DataPropagation {
    when: source_pad.push_item(value: RuntimeValue, ctx: RequestContext)

    requires: source_pad.type = SourcePad

    ensures:
        for sink in source_pad.get_next_pads():
            sink._get_queue().put(
                Item(value: value, ctx: new_context(ctx))
            )
    ensures: ctx.complete()
}

-- ============================================================================
-- NODE EXECUTION
-- ============================================================================

-- Each node has a lifecycle: instantiate, resolve pads, run, cleanup

rule NodeLifecycle {
    when: Node.execute()

    ensures: node.resolve_pads()         -- Discover pad structure
    ensures: node.run()                  -- Begin execution
    ensures: node.cleanup()              -- Graceful shutdown
}

-- Nodes dynamically construct their pad structure
rule NodeResolvePads {
    when: node.resolve_pads()

    ensures:
        for pad in node.pads:
            pad.set_owner_node(node)
            pad._resolve_type_constraints()
}

-- ============================================================================
-- STATE MACHINE NODE
-- ============================================================================

-- The StateMachine node provides finite state machine capability.
-- This is a core node type that demonstrates how complex nodes are specified.

entity StateMachineNode {
    node: Node
    configuration: StateMachineConfiguration
    current_state: String
    previous_state: String
    parameters: List<Parameter>
}

-- StateMachineConfiguration, StateMachineState, StateMachineTransition are defined in core.allium

enum ComparisonOperator {
    LT | LE | EQ | NE | GE | GT |
    NON_EMPTY | EMPTY |
    STARTS_WITH | ENDS_WITH | CONTAINS |
    TRUE | FALSE
}

rule StateMachineTransition {
    when: StateMachineNode.check_transitions(ctx, from_state, current_state)

    requires:
        transition = StateMachineNode.transitions.find(
            t where t.from_state = from_state and conditions_met(t.conditions, parameters)
        )

    ensures:
        StateMachineNode.previous_state = current_state
        StateMachineNode.current_state = transition.to_state
        previous_state_pad.push_item(current_state, ctx)
        current_state_pad.push_item(transition.to_state, ctx)
}

-- ============================================================================
-- SUBGRAPH COMPOSITION
-- ============================================================================

-- Sub-graphs enable graph reuse and hierarchical composition

-- SubGraphNode, ProxyPropertySink, ProxyPropertySource, ProxyStatelessSink are defined in nodes.allium / core.allium

-- ============================================================================
-- SECRET MANAGEMENT
-- ============================================================================

-- Secrets are external credentials referenced by nodes

entity Secret {
    secret_id: String
    name: String
}

-- PublicSecret is defined in repository.allium

-- ============================================================================
-- TYPE CONSTRAINT SYSTEM
-- ============================================================================

-- Type constraints are intersected across connected pads

rule TypeConstraintIntersection {
    when: pads = connected_pad_cluster(pad)

    ensures:
        intersection = pad.get_default_type_constraints()
        for p in pads:
            intersection = INTERSECTION(intersection, p.get_default_type_constraints())
        for p in pads:
            p.set_type_constraints(intersection)
}

-- ============================================================================
-- CONTEXT AND REQUEST HANDLING
-- ============================================================================

-- RequestContext tracks causal chains of events through the graph

entity RequestContext {
    parent: RequestContext?
    timeout: Duration
    originator: String
    publisher_metadata: Any?
}

rule RequestContextPropagation {
    when: source_pad.push_item(value, ctx)

    ensures:
        new_ctx = RequestContext(
            parent: ctx,
            timeout: ctx._timeout_s,
            originator: source_pad.get_id(),
            publisher_metadata: ctx.publisher_metadata
        )
    ensures: Item(value: value, ctx: new_ctx)

    -- Child context inherits from parent
    ensures: new_ctx.original_request = ctx.original_request
}

-- ============================================================================
-- GRAPH OPERATIONS
-- ============================================================================

rule LoadGraphFromSnapshot {
    when: Graph.load(snapshot: GraphEditorRepresentation)

    ensures:
        for node_data in snapshot.nodes:
            node = Node.create(
                type: node_data.type,
                configuration: node_data.pads
            )
            Graph.nodes.add(node)

    ensures:
        for link in snapshot.pad_links:
            source_pad.connect(target_pad)

    ensures:
        for portal in snapshot.portals:
            Graph.portals.add(portal)
}

rule EditGraph {
    when: Graph.apply_edit(edit: GraphEdit)

    ensures:
        if edit.type = INSERT_NODE:
            Node.create(edit.node_type)
        if edit.type = REMOVE_NODE:
            Node.delete(edit.node_id)
        if edit.type = CONNECT_PAD:
            SourcePad.connect(SinkPad)
        if edit.type = DISCONNECT_PAD:
            Pad.disconnect()
        if edit.type = UPDATE_NODE:
            Node.update(edit)
        if edit.type = UPDATE_PAD:
            Pad.update(edit)
}

-- ============================================================================
-- QUERY ELIGIBLE NODES
-- ============================================================================

-- Frontend queries which nodes can connect to a given pad

rule QueryEligibleNodes {
    when: Graph.query_eligible_nodes(source_pad: Pad)

    requires: source_pad.type = SourcePad

    ensures:
        eligible = Set<LibraryItem>
        for item in library_items:
            for pad in item.pads:
                if source_pad.can_connect(pad) and pad.type = SinkPad:
                    eligible.add(item)
    ensures: EligibleNodesResponse(eligible_items: eligible)
}
